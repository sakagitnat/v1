# Alpaca API credentials — get PAPER keys from https://app.alpaca.markets (paper account)
ALPACA_API_KEY=your_paper_api_key
ALPACA_SECRET_KEY=your_paper_secret_key

# Keep this true. The system will only place PAPER (simulated) trades while it is true.
ALPACA_PAPER=true

# Safety switch. Must be explicitly "true" AND ALPACA_PAPER must be "false"
# before any order touches a real-money account. Leave as false until you
# have reviewed weeks/months of paper-trading results and accept the risk.
ALLOW_LIVE_TRADING=false

# Comma-separated symbols the strategy watches
WATCHLIST=SPY,AAPL,MSFT,GOOGL,AMZN,NVDA,GLD

# Reference symbol used by the regime-adaptive strategy as a stand-in for
# "the market" (bull/bear/neutral), independent of what's in WATCHLIST
REGIME_SYMBOL=SPY

# Risk management
RISK_PER_TRADE=0.01
MAX_OPEN_POSITIONS=5
MAX_DAILY_LOSS_PCT=0.03

# Note: the bot also skips new entries into a stock that has an earnings
# report due in the next 2 days (src/trading/data/earnings.py). No env var
# for this -- it's always on and needs no API key (uses yfinance).

# Capital floor ratchet -- only takes effect once a floor is set via
# `python scripts/cli.py set-floor AMOUNT`. See README "Capital floor + risk ladder".
RATCHET_TRIGGER_PCT=0.20
RATCHET_BANK_FRACTION=0.5

# Bucket mode -- WITHDRAWAL_MULTIPLE (e.g. 2.0 = $100 -> $200) is the fixed
# checkpoint the capital floor locks at once reached ("money to withdraw").
# BUCKET_ACTIVATION_MULTIPLE (e.g. 3.0 = $100 -> $300) is when equity above
# that checkpoint starts being split into safe/risk buckets. See README
# "Bucket mode".
WITHDRAWAL_MULTIPLE=2.0
BUCKET_ACTIVATION_MULTIPLE=3.0
BUCKET_SAFE_FRACTION=0.5

# --- CFD/forex (Deriv) -- a completely separate account and system from
# everything above. Get a free DEMO account + API token from
# https://deriv.com (use the "Options" demo account, not the MT5 "CFDs"
# one -- the API can't control that one), then
# https://app.deriv.com/account/api-token with the "Trade" scope checked.
# See README "CFD/forex trading (Deriv)".
DERIV_API_TOKEN=your_deriv_api_token

# App ID from your own registered Deriv application (developers.deriv.com ->
# Register new application -> Native apps, since we use PAT tokens). The
# shared public app_id "1089" only works against the classic WebSocket API
# -- the newer /trading/v1/options REST API this system uses returns
# "Invalid application" (401) unless the app_id belongs to a registered
# application. App IDs are not secret (like an OAuth client_id), safe to
# commit/share. See https://api.deriv.com/docs/setting-up-a-deriv-application
DERIV_APP_ID=your_registered_app_id

# Safety switch, mirrors ALLOW_LIVE_TRADING above. Deriv's account model is
# different from Alpaca/OANDA's paper/live URL switch though -- an API
# token is already scoped to one specific account (demo or real) when it's
# created. The real safety check is at connect time (broker.py checks each
# account's account_type field, "demo" or "real"); this must ALSO be "true"
# before a real (non-demo) account's token is allowed to trade.
CFD_ALLOW_LIVE_TRADING=false

# Comma-separated Deriv instrument names -- mixed-case, case-sensitive
# (frxXAUUSD, not XAU_USD or FRXXAUUSD)
CFD_INSTRUMENTS=frxXAUUSD,frxEURUSD,frxGBPUSD,frxUSDJPY

# Risk management -- separate from the stock system's settings above
CFD_RISK_PER_TRADE=0.01
CFD_MAX_OPEN_POSITIONS=3
CFD_MAX_DAILY_LOSS_PCT=0.03

# Virtual capital model (demo account only -- see README "Capital model:
# virtual equity (demo)"). Deriv's demo balance is fixed at ~$10,000 with
# no API to reset it; every risk/performance calculation is rebased onto
# this number instead, tracking the same P&L 1:1. Real accounts are never
# rebased.
CFD_VIRTUAL_STARTING_CAPITAL=100.0

# Deriv's confirmed live minimum stake for a Multipliers order. A trade
# whose risk-budgeted stake would come out below this is SKIPPED, never
# rounded up past the configured risk.
CFD_MIN_STAKE=1.0
