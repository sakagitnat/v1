# Alpaca API credentials — get PAPER keys from https://app.alpaca.markets (paper account)
ALPACA_API_KEY=your_paper_api_key
ALPACA_SECRET_KEY=your_paper_secret_key

# Keep this true. The system will only place PAPER (simulated) trades while it is true.
ALPACA_PAPER=true

# Safety switch. Must be explicitly "true" AND ALPACA_PAPER must be "false"
# before any order touches a real-money account. Leave as false until you
# have reviewed weeks/months of paper-trading results and accept the risk.
ALLOW_LIVE_TRADING=false

# Comma-separated symbols the strategy watches
WATCHLIST=SPY,AAPL,MSFT,GOOGL,AMZN,NVDA,GLD

# Reference symbol used by the regime-adaptive strategy as a stand-in for
# "the market" (bull/bear/neutral), independent of what's in WATCHLIST
REGIME_SYMBOL=SPY

# Risk management
RISK_PER_TRADE=0.01
MAX_OPEN_POSITIONS=5
MAX_DAILY_LOSS_PCT=0.03

# Note: the bot also skips new entries into a stock that has an earnings
# report due in the next 2 days (src/trading/data/earnings.py). No env var
# for this -- it's always on and needs no API key (uses yfinance).

# Capital floor ratchet -- only takes effect once a floor is set via
# `python scripts/cli.py set-floor AMOUNT`. See README "Capital floor + risk ladder".
RATCHET_TRIGGER_PCT=0.20
RATCHET_BANK_FRACTION=0.5

# Bucket mode -- WITHDRAWAL_MULTIPLE (e.g. 2.0 = $100 -> $200) is the fixed
# checkpoint the capital floor locks at once reached ("money to withdraw").
# BUCKET_ACTIVATION_MULTIPLE (e.g. 3.0 = $100 -> $300) is when equity above
# that checkpoint starts being split into safe/risk buckets. See README
# "Bucket mode".
WITHDRAWAL_MULTIPLE=2.0
BUCKET_ACTIVATION_MULTIPLE=3.0
BUCKET_SAFE_FRACTION=0.5

# --- CFD/forex (OANDA) -- a completely separate account and system from
# everything above. Get a free PRACTICE account + API token from
# https://hub.oanda.com/apply/demo, then Account Management Portal ->
# "My Services" -> "Manage API Access". See README "CFD/forex trading (OANDA)".
OANDA_API_TOKEN=your_oanda_api_token
OANDA_ACCOUNT_ID=your_oanda_account_id

# Keep this true. The system will only place PRACTICE (simulated) trades while it is true.
OANDA_PRACTICE=true

# Safety switch, mirrors ALLOW_LIVE_TRADING above. Must be explicitly "true"
# AND OANDA_PRACTICE must be "false" before any order touches a real-money
# account.
CFD_ALLOW_LIVE_TRADING=false

# Comma-separated OANDA instrument names (underscore, not slash)
CFD_INSTRUMENTS=XAU_USD,EUR_USD,GBP_USD,USD_JPY

# Risk management -- separate from the stock system's settings above
CFD_RISK_PER_TRADE=0.01
CFD_MAX_OPEN_POSITIONS=3
CFD_MAX_DAILY_LOSS_PCT=0.03
